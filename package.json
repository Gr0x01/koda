{
  "name": "koda",
  "version": "0.1.17-nightly.1767.20260904003643.d26505f3",
  "description": "A guardrailed Claude Code distribution as a Mac desktop app for non-engineers.",
  "private": true,
  "author": "RB",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build-assist-helper && npm run build-voice-helper && npm run vendor-playwright && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine-contract": "vitest run --config vitest.engine.config.ts test/engine-contract/smoke.test.ts -t \"Check [1-7](?:[a-z])? —\"",
    "test:engine-behavior-rehearsal": "vitest run --config vitest.engine.config.ts test/engine-contract/smoke.test.ts -t \"Check 8 —\"",
    "test:engine-contract-codex": "vitest run --config vitest.engine.config.ts test/engine-contract/codex-smoke.test.ts",
    "fetch-engine": "node scripts/fetch-engine.mjs",
    "fetch-candidate-engine": "node scripts/fetch-candidate-engine.mjs",
    "fetch-candidate-codex": "node scripts/fetch-candidate-codex.mjs",
    "build-assist-helper": "node scripts/build-assist-helper.mjs",
    "build-voice-helper": "node scripts/build-voice-helper.mjs",
    "vendor-playwright": "node scripts/vendor-playwright.mjs",
    "dist": "if [ -f .env.dist ]; then set -a; . ./.env.dist; set +a; fi; export KODA_DIST=1 KODA_UPDATE_CHANNEL=${KODA_UPDATE_CHANNEL:-latest} && npm run fetch-engine && npm run build-assist-helper && npm run build-voice-helper && npm run vendor-playwright && npm run build && electron-builder --mac",
    "test:e2e:prepare": "npm run build-assist-helper && npm run build-voice-helper && npm run vendor-playwright && npm run build",
    "test:e2e:run": "playwright test --grep-invert @mac-account",
    "test:e2e": "npm run test:e2e:prepare && npm run test:e2e:run",
    "test:e2e:mac-account": "npm run test:e2e:prepare && KODA_E2E_REAL_ACCOUNTS=1 playwright test --grep @mac-account"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@fontsource-variable/schibsted-grotesk": "^5.2.8",
    "@fontsource-variable/spline-sans-mono": "^5.2.8",
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "^7.21.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.108.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.23.0",
    "monaco-editor": "^0.55.1",
    "motion": "^12.42.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.5",
    "vitest": "^4.1.10"
  }
}
